# Copy to .env next to docker-compose.yml on the server. Never commit the real file.
TAILSCALE_IP=100.x.y.z            # this server's `tailscale ip -4`; Kafka TAILNET listener for agents
HOST_BIND=127.0.0.1               # Kafka 9092, TimescaleDB, API: reachable from the server only
DASHBOARD_BIND=100.x.y.z          # dashboard: reachable over Tailscale only
POSTGRES_PASSWORD=change-me       # hex only (it is embedded in a URL): openssl rand -hex 24
